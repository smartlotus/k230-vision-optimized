  "model_copy_script": "import os,sys,json\nsys.path.insert(0,'/sdcard/tfp1116')\nfrom k230.topface_adapter import digest,MODEL_SHA\nsource='/sdcard/topface_formal_a01_20261116'\ntarget='/sdcard/tfp1116/model'\nif digest(source+'/topface.kmodel')!=MODEL_SHA:raise ValueError('Source model differs')\nfor name in ('topface.kmodel','identity.json','output_contract.json'):\n with open(source+'/'+name,'rb') as src,open(target+'/'+name,'wb') as dst:\n  while True:\n   block=src.read(4096)\n   if not block:break\n   dst.write(block)\n if digest(source+'/'+name)!=digest(target+'/'+name):raise ValueError('Model copy byte mismatch')\nprint('TOPFACE_PRODUCTION_COPY_VERIFIED_1116')\n"
